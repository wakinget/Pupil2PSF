# -----------------------
# Pupil2PSF .gitignore
# -----------------------

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE settings
.idea/
.vscode/

# Logs and temporary files
*.log
*.tmp
*.swp

# Node-related (if you ever use npm)
node_modules/

# Python virtual environments (for PyCharm’s Python interpreter tracking)
.venv/
venv/

# Build or cache artifacts (future-proofing)
dist/
build/
__pycache__/

# Backup or exported images
*.bak
*.old
*.png~
*.jpg~

# Environment and private keys (if any)
.env
.env.*
